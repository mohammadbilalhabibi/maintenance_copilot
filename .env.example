# Copy to .env and fill in. Never commit .env.

# --- LLM (any OpenAI-compatible API) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=800
# Max LLM turns per question (stops tool loops)
AGENT_MAX_STEPS=8
TOOL_TIMEOUT=15
# USD per 1M tokens for LLM_MODEL (used for the cost per request; check your provider's price list)
LLM_PRICE_INPUT_PER_M=0.15
LLM_PRICE_CACHED_INPUT_PER_M=0.075
LLM_PRICE_OUTPUT_PER_M=0.60

# --- Database ---
# Local default: SQLite file data/copilot.sqlite. Docker Compose uses Postgres:
# DATABASE_URL=postgresql+asyncpg://copilot:copilot@postgres:5432/copilot
# Read-only role for the agent's data tools (Postgres only; defaults to DATABASE_URL):
# TOOLS_DATABASE_URL=postgresql+asyncpg://copilot_ro:copilot_ro@postgres:5432/copilot
FLEET_SIZE=100
# Simulated "now" inside the 2015 sample data (tools never return later data)
SIM_NOW=2015-11-15T08:00:00

# --- Auth / API ---
# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=720
RATE_LIMIT_PER_MINUTE=20
ALLOW_REGISTRATION=true

# --- Documents ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SEARCH_TOP_K=4

# --- Observability (Arize Phoenix); unset = tracing off ---
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=maintenance-copilot

# --- Docker Compose ---
# Host port for the app (change if 8000 is taken)
APP_PORT=8000
# LangGraph checkpoint writes: async (every step) | exit (end of run / confirmation only)
CHECKPOINT_DURABILITY=exit
